# URL of the deployed API (leave empty in local development – Vite proxies /api to http://localhost:5000)
VITE_API_URL=
# Public URL of this website (used for canonical URLs and Open Graph). Falls back to the current origin.
VITE_SITE_URL=http://localhost:5173
# Set a Plausible domain to enable the cookie/analytics choice banner. Leave empty for no tracking at all.
VITE_PLAUSIBLE_DOMAIN=atelier-north.example

VITE_DEV_API=http://localhost:5000