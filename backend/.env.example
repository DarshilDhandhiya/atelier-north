# ---------- Core ----------
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/atelier_north
# 32+ random characters in production:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me-please-0123456789
JWT_EXPIRES_HOURS=8

# ---------- URLs / CORS ----------
# Comma-separated list of allowed browser origins (the deployed frontend URL(s))
CLIENT_ORIGINS=http://localhost:5173
# Public URL of the frontend (used for sitemap, canonical URLs, e-mail links)
SITE_URL=http://localhost:5173
# Public URL of THIS API (used to build absolute URLs for uploaded images)
PUBLIC_API_URL=http://localhost:5000

# ---------- Admin session cookie ----------
# Same-site deployment (frontend + API on one domain / sub-domains): lax
# Cross-site deployment (e.g. vercel.app + onrender.com): COOKIE_SAMESITE=none and COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# Set true behind a reverse proxy / PaaS load balancer (Render, Railway, Fly, Nginx...)
TRUST_PROXY=false
# Redirect http -> https in production (needs TRUST_PROXY=true behind a proxy)
FORCE_HTTPS=false

# ---------- Media storage ----------
# local  = files saved to UPLOAD_DIR and served from /uploads
# cloudinary = set CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
CLOUDINARY_URL=
MAX_IMAGE_MB=8
MAX_ATTACHMENT_MB=10

# ---------- E-mail (Nodemailer + SMTP) ----------
# Leave SMTP_HOST empty to run without e-mail (enquiries are still saved; status = "skipped")
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Atelier North <no-reply@atelier-north.example>
STAFF_NOTIFY_EMAIL=studio@atelier-north.example
# Also send a short acknowledgement to the person who enquired
SEND_CUSTOMER_ACK=false
EMAIL_RETRY_INTERVAL_MIN=5
EMAIL_MAX_ATTEMPTS=5

# ---------- Enquiry form protection ----------
ENQUIRY_RATE_LIMIT_MAX=5
ENQUIRY_RATE_LIMIT_WINDOW_MIN=60
LOGIN_RATE_LIMIT_MAX=10

# ---------- Seed (demo users) ----------
SEED_ADMIN_EMAIL=admin@atelier-north.test
SEED_ADMIN_PASSWORD=Atelier!Admin2026
SEED_EDITOR_EMAIL=editor@atelier-north.test
SEED_EDITOR_PASSWORD=Atelier!Editor2026
